{
  "simulation": "vertex_deletion",
  "lattice": {
    "type": "square",
    "dimensions": [
      50,
      100,
      150,
      200,
      250,
      300,
      350,
      400,
      450,
      500,
      550,
      600,
      650,
      700,
      750,
      800,
      850,
      900
    ],
    "weights": [1.0]
  },
  "measurement": {
    "probability_grid": {
      "start": 0.3,
      "stop": 0.5,
      "num": 150,
      "endpoint": true
    }
  },
  "sampling": {
    "realizations": 1000,
    "random_seed": 2026
  },
  "parallelization": {
    "max_workers": 50,
    "reserve_cores": 2
  },
  "output": {
    "directory": "data/vertex_deletion/new",
    "filename_template": "Raw_Graph_Data_w_{weight:.1f}.pkl",
    "resume": true,
    "overwrite": false
  }
}